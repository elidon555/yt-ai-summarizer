{
  "manifest_version": 3,
  "name": "YouTube Transcript to Claude",
  "version": "0.2.0",
  "description": "Adds a YouTube player button that copies the transcript and sends it to Claude.",
  "permissions": [
    "tabs",
    "storage",
    "scripting",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://m.youtube.com/*",
    "https://claude.ai/*"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "css": [
        "assets/css/youtube.css"
      ],
      "js": [
        "assets/js/defaults.js",
        "assets/js/icons.js",
        "content/youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": [
        "assets/js/defaults.js",
        "content/claude.js"
      ],
      "run_at": "document_start"
    }
  ]
}
